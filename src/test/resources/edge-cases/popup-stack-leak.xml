<Theme version="2.0">
  <ThemeInfo name="Popup stack leak"/>
  <Bitmap id="b" file="shared.png" alphacolor="#FF00FF"/>
  <PopupMenu id="menu1">
    <MenuItem label="One" action="none"/>
  </PopupMenu>
  <PopupMenu id="menu2">
    <MenuItem label="Two" action="none"/>
  </PopupMenu>
  <MenuItem label="Leaked" action="none"/>
